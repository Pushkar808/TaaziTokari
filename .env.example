# Copy to .env and fill in. Never commit the real .env.

# --- Backend ---
PORT=4000
FRONTEND_URL="http://localhost:3000"
# Supabase -> Project Settings -> Database -> connection string (Postgres only; no Supabase API keys are used)
DATABASE_URL="postgresql://postgres.<project>:<password>@<host>:5432/postgres"
# Long random string that signs login tokens, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
# Google Cloud Console -> Credentials -> OAuth client ID (Web). Add http://localhost:3000 as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=""
# `npm run db:seed` creates (or updates) this admin account
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
# Same value as in Razorpay Dashboard -> Webhooks
RAZORPAY_WEBHOOK_SECRET=""

# --- Frontend (VITE_ values are visible in the browser) ---
VITE_GOOGLE_CLIENT_ID=""
VITE_APP_NAME="Taazi Tokari"
VITE_APP_TAGLINE="Kishan Fresh to Kitchen"
VITE_DEFAULT_CITY="Lucknow"
VITE_DEFAULT_STATE="Uttar Pradesh"
